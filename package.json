{
  "name": "visbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "ai:server": "node --env-file-if-exists=.env server/index.mjs",
    "ai:vision:agree": "node --env-file-if-exists=.env scripts/agree-vision-model.mjs",
    "lint": "eslint src server tests scripts *.ts --max-warnings=0",
    "format:check": "prettier --check src server tests scripts *.ts *.mjs *.json .github/workflows",
    "format": "prettier --write src server tests scripts *.ts *.mjs *.json .github/workflows"
  },
  "dependencies": {
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "konva": "^10.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "sass": "^1.83.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "license": "UNLICENSED"
}
